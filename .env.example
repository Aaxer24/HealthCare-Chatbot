GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
MODEL_TEMPERATURE=0.1
RETRIEVAL_K=8
RERANK_K=5
ENABLE_RERANKING=true
LOG_LEVEL=INFO

